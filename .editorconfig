root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[tests/fixtures/proc/**]
# Fixtures are byte-exact copies of kernel files: never touch them.
insert_final_newline = unset
trim_trailing_whitespace = unset

[src/ui/fonts/{LICENSE.*,*.qkatlas}]
# Third-party licence text and generated atlases: keep byte-exact.
trim_trailing_whitespace = unset
insert_final_newline = unset
